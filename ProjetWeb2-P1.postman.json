{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "ProjetWeb2 - Projeto P1",
		"description": "Collection completa da API NodeJS com Express e TypeORM",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "{{host_url}}/api"
		},
		{
			"key": "host_url",
			"value": "http://localhost:8080"
		}
	],
	 "item": [
    {
      "name": " Test Connection",
      "item": [
        {
          "name": "Test API Connection",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/test-connection",
            "description": "Verifica se a API está rodando"
          }
        }
      ]
    },
    {
      "name": " Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.user && json.user.token) {",
                  "  pm.collectionVariables.set('token', json.user.token);",
                  "  console.log('Token salvo automaticamente!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mateus@email.com\",\n  \"password\": \"123456\"\n}"
            },
            "description": "POST /api/auth — retorna token JWT. Token salvo automaticamente na variável {{token}}"
          }
        },
        {
          "name": "Validar Token",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/validate-token",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "GET /api/auth/validate-token — verifica se o token JWT é válido"
          }
        },
        {
          "name": "Criar Usuário (via Auth)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/new-users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Novo Usuario\",\n  \"email\": \"novo@email.com\",\n  \"password\": \"123456\",\n  \"situationId\": 1\n}"
            },
            "description": "POST /api/auth/new-users — cadastro público de usuário"
          }
        },
        {
          "name": "Recuperar Senha",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/recover-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mateus@email.com\",\n  \"urlRecoverPassword\": \"http://localhost:3000/reset-password\"\n}"
            },
            "description": "POST /api/auth/recover-password — envia e-mail com link de recuperação"
          }
        },
        {
          "name": "Atualizar Senha",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/update-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mateus@email.com\",\n  \"recoverPassword\": \"TOKEN_RECEBIDO_POR_EMAIL\",\n  \"password\": \"novaSenha123\"\n}"
            },
            "description": "PUT /api/auth/update-password — redefine a senha com o token recebido por e-mail"
          }
        }
      ]
    },
    {
