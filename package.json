{
  "name": "api-nodeapi",
  "version": "1.0.0",
  "description": "ProjetWeb2 com Express e TypeORM",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "node --import ts-node/register --watch src/index.ts",
    "start:watch": "concurrently \"npx tsc -w\" \"node --watch dist/index.js\"",
    "migration:run": "npx typeorm migration:run -d dist/data-source.js",
    "migration:revert": "npx typeorm migration:revert -d dist/data-source.js",
    "seed": "node dist/run-seeds.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "slugify": "^1.6.9",
    "typeorm": "^0.3.20",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.15.2",
    "@types/nodemailer": "^6.4.23",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
